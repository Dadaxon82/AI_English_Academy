# ============================================================
# AI English Academy — muhit o'zgaruvchilari namunasi
# ============================================================
# BU FAYLNI .env ga nusxalang:  cp .env.example .env
#
# DIQQAT: bu yerdagi qiymatlarni kodga yozmang va kalitlarni
# git'ga kiritmang. API kalitlari frontendga chiqarilmaydi —
# AI so'rovlari serverless funksiya orqali bajariladi.
# ============================================================

# --- Supabase (majburiy emas) --------------------------------
#supabase dashboard > Project Settings > API
# Public anons kaliti FQAT shu o'zgaruvchida ishlatiladi:
VITE_SUPABASE_URL=https://xxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key

# --- Server (edge function / local script) -------------------
# service role key FQAT serverda. Hech qachon VITE_ prefiksi bilan
# frontendga chiqarilmaydi:
SUPABASE_URL=https://xxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# --- AI integratsiyasi (ixtiyoriy) ---------------------------
# AI xizmati majburiy emas. Bo'sh qoldirilsa, dastur qoidaviy
# tekshiruv va tayyor mashqlar bilan ishlayveradi.
# Faqat server tomonda o'qiladi (supabase/functions/ai-feedback):
#   supabase secrets set AI_PROVIDER=anthropic AI_API_KEY=... AI_DAILY_LIMIT=20
#   supabase functions deploy ai-feedback
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_API_KEY=
# Xarajatni cheklash: bir foydalanuvchiga kunlik maksimal AI chaqiruvlari
AI_DAILY_LIMIT=20
# Bir so'rov uchun maksimal javob hajmi (token)
AI_MAX_TOKENS=4000
# Funksiya joylangach veb build'da yoqiladi (aks holda "qoidaviy" tahlil):
VITE_AI_ENABLED=false

# --- Boshqa ---------------------------------------------------
# Browser Speech Recognition (Speaking) — brauzer qo'llasa ishlaydi,
# kalit talab qilmaydi. Transkripsiya xizmati bo'lmasa matnli muqobil
# usul ishlatiladi.
VITE_APP_ENV=development
