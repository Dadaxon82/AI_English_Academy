<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DayNight: tungi variant values-night/themes.xml'da. -->
    <style name="Theme.Aea" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_blue</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/card_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorError">@color/err</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_blue</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg_light</item>
    </style>

    <!-- Kartalar: radius 16dp, elevation 2dp (loyiha talabi). -->
    <style name="Widget.Aea.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="contentPadding">@dimen/gap_l</item>
    </style>

    <style name="Widget.Aea.Card.Flat" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/gap_m</item>
    </style>

    <style name="Text.Aea.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Aea.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Aea.Body" parent="TextAppearance.Material3.BodyMedium" />

    <style name="Text.Aea.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Aea.Number" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_big_number</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Aea.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Aea.Button.Text" parent="Widget.Material3.Button.TextButton" />

    <style name="Widget.Aea.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton" />

    <style name="Widget.Aea.Chip" parent="Widget.Material3.Chip.Assist" />

    <style name="Widget.Aea.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox" />
</resources>
